# ==============================================================================
# BazaarSetu (Project ZeroType) — Environment Template (.env.example)
# Copy this file to .env and fill in your keys.
# ==============================================================================

# ── 1. Pipeline Control ───────────────────────────────────────────────────────
# Set to false to run live AI inference & real backend; true for offline testing
USE_MOCK_DATA=false

# Voice pipeline mode: "bhashini" | "groq" | "auto"
VOICE_PIPELINE=auto

# AI catalog extraction provider: "groq_qwen" (recommended free) | "custom_qwen" | "gemini"
AI_EXTRACTION_PROVIDER=groq_qwen

# ── 2. Primary AI Extraction: Qwen (Groq Free API or Custom Backend) ─────────
# Get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
QWEN_MODEL=qwen/qwen3.8-27b
QWEN_API_URL=https://api.groq.com/openai/v1/chat/completions

# ── 3. Bhashini Cloud Services (Govt. of India Indic NLP) ──────────────────────
# Credentials from your Bhashini / Dhruva dashboard (https://bhashini.gov.in)
BHASHINI_API_KEY=your_bhashini_inference_api_key
BHASHINI_ULCA_KEY=your_bhashini_ulca_key
BHASHINI_USER_ID=your_bhashini_numeric_user_id
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in

# ── 4. Backend Endpoints (BiRefNet Studio Processing & ONDC BPP) ───────────────
# AI Vision / Studio matting backend (FastAPI / Kaggle / Ngrok)
BACKEND_URL=http://localhost:8000

# ONDC Beckn Provider Platform (BPP / Seller Node webhook server)
BPP_BACKEND_URL=http://localhost:8000

# Core API Base URL
API_BASE_URL=https://api.bazaarsetu.in/v1

# ── 5. Deprecated / Optional Fallbacks ─────────────────────────────────────────
# Gemini is deprecated in favor of Qwen. Only needed if AI_EXTRACTION_PROVIDER=gemini:
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
