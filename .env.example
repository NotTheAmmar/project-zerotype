# ==============================================================================
# BazaarSetu (Project ZeroType) — Mobile App Environment Template (.env.example)
# Copy this file to .env at the repository root and fill in your keys.
# ==============================================================================

# ==============================================================================
# 1. ⚡ QUICK START / OFFLINE MODE
# ==============================================================================
# Set to 'true' to run the app with built-in mock data (no network or API keys required).
# Set to 'false' to test real voice STT, Qwen AI extraction, and live BPP publishing.
USE_MOCK_DATA=false

# ==============================================================================
# 2. 🌐 BACKEND & ONDC BPP ENDPOINTS
# ==============================================================================
# Local FastAPI development:
#   - Linux/Desktop/Physical device on LAN: http://<local-ip>:8000
#   - Android Emulator: http://10.0.2.2:8000
#   - Render Cloud: https://<your-render-app-name>.onrender.com
BPP_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
API_BASE_URL=https://api.bazaarsetu.in/v1

# ==============================================================================
# 3. 🎙️ VOICE STT & MULTILINGUAL PIPELINE
# ==============================================================================
# Voice pipeline mode: "auto" (recommended) | "bhashini" | "groq"
VOICE_PIPELINE=auto

# Bhashini Cloud Services (Govt. of India Indic NLP)
# Dashboard: https://bhashini.gov.in
BHASHINI_API_KEY=your_bhashini_inference_api_key
BHASHINI_ULCA_KEY=your_bhashini_ulca_key
BHASHINI_USER_ID=your_bhashini_numeric_user_id
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in

# ==============================================================================
# 4. 🧠 AI CATALOG EXTRACTION (Qwen via Groq)
# ==============================================================================
# Primary AI extraction provider: "groq_qwen" (recommended free tier) | "custom_qwen"
AI_EXTRACTION_PROVIDER=groq_qwen

# Free API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
QWEN_MODEL=qwen/qwen3.8-27b
QWEN_API_URL=https://api.groq.com/openai/v1/chat/completions
