# ─────────────────────────────────────────────────────────────────────────────
# BazaarSetu BPP — Backend Environment Template (.env.example)
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# 1. 🚨 RENDER CLOUD DEPLOYMENT (Minimal Required on Render Dashboard)
# =============================================================================

# Publicly reachable URI of this BPP server.
# Set this to your Render service URL + /beckn so the ONDC network knows where
# to route callbacks.
# Local default: http://localhost:8000/beckn
BPP_PUBLIC_URI=https://<your-render-app-name>.onrender.com/beckn

# PostgreSQL connection string for persistent catalog storage.
# ⚠️ CRITICAL FOR RENDER:
# Render's free tier does NOT support IPv6 outbound traffic.
# Supabase direct host (db.[ref].supabase.co) resolves to IPv6 and WILL FAIL.
# You MUST use the Supabase Connection Pooler URI (IPv4):
# Mode: Transaction (port 6543) or Session (port 5432)
# Username format: postgres.[YOUR-PROJECT-REF] (NOT just postgres)
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# =============================================================================
# 2. 🖼️ SUPABASE STORAGE & CDN (Craft Images: Raw Camera & Studio Photos)
# =============================================================================
# Used by POST /api/v1/bpp/upload-image to host public images for ONDC buyer apps.
# If omitted or left blank, the backend falls back to serving images from local /uploads/.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-OR-ANON-KEY]
SUPABASE_STORAGE_BUCKET=craft-images

# =============================================================================
# 3. 🔐 ONDC NETWORK IDENTITY & SIGNING (Optional / Staging)
# =============================================================================
# For ONDC Workbench & local mock testing, these have built-in defaults.
# You only need to set these when connecting to the official ONDC staging/pilot registry.
BPP_SUBSCRIBER_ID=bazaarsetu.bpp.org
BPP_UK_ID=key-1

# Ed25519 signing keypair (base64 encoded).
# Generate a fresh keypair using: python backend/generate_keys.py
# Leave blank for ONDC Workbench mock testing (inbound auth is not enforced).
BPP_SIGNING_PRIVATE_KEY=
BPP_SIGNING_PUBLIC_KEY=

# ONDC Gateway URL — Proactive catalog pushes (leave empty for Workbench)
GATEWAY_URL=

# =============================================================================
# 4. 💻 LOCAL SERVER DEFAULTS
# =============================================================================
# Automatically handled by Render ($PORT). Use for local uvicorn runs.
HOST=0.0.0.0
PORT=8000
